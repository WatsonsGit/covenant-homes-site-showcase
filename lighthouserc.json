{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/",
        "http://localhost:3100/how-it-works",
        "http://localhost:3100/our-process",
        "http://localhost:3100/neighborhoods/west-philadelphia",
        "http://localhost:3100/neighborhoods/kensington",
        "http://localhost:3100/situations/inherited-house",
        "http://localhost:3100/situations/tired-landlord",
        "http://localhost:3100/faq"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 1.0 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
